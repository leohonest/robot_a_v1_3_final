# =============================================================================
# Robot-A Project - Real Environment Configuration
# =============================================================================
#
# This .env.example reflects the ACTUAL reference deployment topology used
# by the Robot-A project. IP addresses and ports are the real production
# values (internal network only, NOT public).
#
#
# Architecture diagram:
#
#   [Walt Windows 10.86.50.x]
#           |
#           | SSH
#           v
#   [DGX 10.86.51.122]  ---> Hosts hybrid_router / AGV SLAM / LLM / etc
#           |
#           | SSH / WiFi
#           v
#   [Linglong Jetson 192.168.1.12]  ---> Hosts voice listener v3
#           |
#           | WiFi / 仙工 Robokit protocol
#           v
#   [AGV 仙工底盘 192.168.1.204]  ---> 6 TCP endpoints (19204-19210)
#
# =============================================================================
# SECTION 1 — CLOUD API CREDENTIALS
# =============================================================================

# MiniMax M3 (cloud LLM, 200K context, complex reasoning)
MINIMAX_API_KEY=<YOUR_MINIMAX_M3_KEY>
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3

# Feishu (Lark) - IM notifications
FEISHU_APP_ID=<YOUR_FEISHU_APP_ID>
FEISHU_APP_SECRET=<YOUR_FEISHU_APP_SECRET>

# iFlytek TTS - fallback TTS provider
IFLYTEK_API_KEY=<YOUR_IFLYTEK_API_KEY>
IFLYTEK_API_SECRET=<YOUR_IFLYTEK_API_SECRET>


# =============================================================================
# SECTION 2 — SSH ENDPOINTS (internal network)
# =============================================================================

# DGX server (Ubuntu 22.04) - hosts all backend services
DGX_HOST=10.86.51.122
DGX_PORT=22
DGX_USER=kk
DGX_PASSWORD=<YOUR_DGX_PASSWORD>

# Linglong robot (NVIDIA Jetson Orin, Ubuntu 22.04)
LINGLONG_HOST=192.168.1.12
LINGLONG_PORT=22
LINGLONG_USER=user
LINGLONG_PASSWORD=<YOUR_LINGLONG_PASSWORD>

# Linglong SDK bridge (upper-limb control)
LINGLONG_SDK_HOST=192.168.1.28
LINGLONG_SDK_PORT=8080


# =============================================================================
# SECTION 3 — AGV (仙工 Robokit AMR)
# =============================================================================
# See xiangong-agv-slam/SKILL.md for full command reference.

AGV_HOST=192.168.1.204
AGV_PORT_STATE=19204      # status queries
AGV_PORT_CMD=19205         # motion control
AGV_PORT_NAV=19206         # navigation
AGV_PORT_CFG=19207         # configuration
AGV_PORT_PUSH=19301        # push notifications
AGV_PORT_OTHER=19210       # SLAM control (6100/6101)

# Station aliases (Leo 9/15 命名规则)
AGV_STATION_DOOR=LM5
AGV_STATION_WORKSTATION_PRIMARY=LM3
AGV_STATION_WORKSTATION_SECONDARY=LM4


# =============================================================================
# SECTION 4 — DGX-HOSTED SERVICE PORTS
# =============================================================================
# All services are HTTP, bound to 0.0.0.0.
# In production: add Token auth + restrict via firewall.

CHASSIS_HTTP_PORT=7781
ASR_HTTP_PORT=7780
TTS_HTTP_PORT=9003
HYBRID_ROUTER_PORT=7785
LLM_ORCHESTRATOR_PORT=7792
ACTION_ROUTER_PORT=7793
AGV_SLAM_PORT=7794
VOICE_CMD_PORT=7778


# =============================================================================
# SECTION 5 — FILE PATHS
# =============================================================================

# DGX
DGX_SCRIPTS_DIR=/data/linglong-project/scripts
DGX_LOG_DIR=/tmp
DGX_VENV_PYTHON=/data/linglong-project/envs/vla/bin/python3
DGX_PROTOBUF_PATH=/home/kk/pythonProject

# Linglong
LINGLONG_HOME=/home/user
LINGLONG_LOG_DIR=/tmp
LINGLONG_DEVICE_INPUT=plughw:3:0    # microphone
LINGLONG_DEVICE_OUTPUT=plughw:1:0   # speaker

# Windows (Walt)
WORKSPACE_DIR=C:\\Users\\DFET\\.openclaw\\workspace


# =============================================================================
# SECTION 6 — SAFETY LIMITS (Leo 9/14 拍板)
# =============================================================================

AGV_MAX_LINEAR_SPEED_MS=0.1

# action_router 语音指令安全上限（V1.3 新增）
ACTION_MAX_DISTANCE_M=2.0
ACTION_MAX_ANGLE_DEG=180.0
ACTION_MAX_DURATION_S=60.0
# ACTION_ROUTER_DRYRUN=1   # 置 1 时空跑（不下发真实指令）
AGV_MAX_ANGULAR_SPEED_DEGS=15
AGV_MAX_DURATION_S=60
AGV_MIN_SAFE_BATTERY_PCT=20
AGV_PATH_MAX_SPEED_MS=0.3


# =============================================================================
# SECTION 7 — HYBRID ROUTER (V1.2 NEW)
# =============================================================================

HYBRID_ROUTER_ENABLED=true
HYBRID_LOCAL_MODEL=qwen-4b
HYBRID_CLOUD_MODEL=MiniMax-M3
HYBRID_TOKEN_BUDGET_PER_DAY=70000000
HYBRID_CACHE_TTL_S=600
HYBRID_DECISION_LOCAL_THRESHOLD=0.8
HYBRID_CACHE_DB_PATH=/data/linglong-project/hybrid_router.db


# =============================================================================
# SECTION 8 — SKILL / AGENT SYSTEM
# =============================================================================

SKILL_AUTO_LOAD=true
SKILL_HYBRID_MODE=true
HYBRID_ROUTER_MOCK_MODE=true


# =============================================================================
# SECTION 9 — DEBUG / LOGGING
# =============================================================================

DEBUG_LEVEL=INFO
LOG_REQUEST_ENABLED=true
LOG_FORMAT=json
LOG_DESTINATION=file


# =============================================================================
# SECTION 10 — PROJECT METADATA
# =============================================================================

PROJECT_NAME=robot-controlled-by-ai-agent-and-local-skill
PROJECT_VERSION=1.3.0
PROJECT_RELEASED=2026-10-01
PROJECT_LICENSE=MIT
